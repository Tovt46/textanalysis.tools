{
  "name": "textanalysis-tools",
  "version": "0.2.0",
  "description": "Local-first text analysis CLI and MCP server for people, automation, and AI agents.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "textanalysis": "dist/textanalysis.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./schema/textanalysis.config.json": "./schema/textanalysis.config.schema.json"
  },
  "types": "index.d.ts",
  "files": [
    "dist/textanalysis.mjs",
    "dist/index.mjs",
    "index.d.ts",
    "schema/textanalysis.config.schema.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tovt46/textanalysis.tools.git",
    "directory": "packages/cli"
  },
  "homepage": "https://textanalysis.tools/",
  "bugs": {
    "url": "https://github.com/Tovt46/textanalysis.tools/issues"
  },
  "keywords": [
    "text-analysis",
    "word-frequency",
    "keyword-density",
    "bag-of-words",
    "tf-idf",
    "ngrams",
    "text-similarity",
    "cli",
    "mcp",
    "ai-agents",
    "automation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
